import argparse
from pathlib import Path

import easyocr
import matplotlib.pyplot as plt
import numpy as np
import pymupdf
from PIL import Image


IMAGE_SIZE = 2000
DEFAULT_INPUT_FOLDER = Path(__file__).with_name("text_images_span")
DEFAULT_OUTPUT_FOLDER = Path(__file__).with_name("300x300_images")


def render_pdf(pdf_path: Path) -> Image.Image:
	"""Render the first page of a PDF as an RGB image."""
	with pymupdf.open(pdf_path) as document:
		if not document.page_count:
			raise ValueError(f"{pdf_path.name} does not contain any pages")

		page = document[0]
		pixmap = page.get_pixmap(alpha=False)
		return Image.frombytes("RGB", (pixmap.width, pixmap.height), pixmap.samples)


def downsample(image: Image.Image, image_size: int = IMAGE_SIZE) -> Image.Image:
	"""Resize an image to exactly image_size by image_size pixels."""
	if image_size <= 0:
		raise ValueError("image_size must be greater than 0")
	return image.resize((image_size, image_size), Image.Resampling.LANCZOS)


def normalize_pixels(image: Image.Image) -> np.ndarray:
	"""Convert an image to grayscale and normalize pixels to values from 0 to 1."""
	grayscale_image = image.convert("L")
	normalized_pixels = np.asarray(grayscale_image, dtype=np.float32) / 255.0
	return np.clip(normalized_pixels, 0.0, 1.0)


def remove_dark_blocks(
	image_array: np.ndarray,
	block_size: int = 125,
	mean_threshold: float = 0.650,
) -> np.ndarray:
	"""Replace 50x50 blocks at or below the grayscale threshold with white."""
	if image_array.ndim != 2:
		raise ValueError("image_array must be a 2D grayscale array")
	if block_size <= 0 or image_array.shape[0] % block_size or image_array.shape[1] % block_size:
		raise ValueError("image dimensions must be evenly divisible by block_size")
	if not 0.0 <= mean_threshold <= 1.0:
		raise ValueError("mean_threshold must be between 0 and 1")

	cleaned_array = image_array.copy()
	for top in range(0, image_array.shape[0], block_size):
		for left in range(0, image_array.shape[1], block_size):
			block = image_array[top:top + block_size, left:left + block_size]
			if float(block.mean()) <= mean_threshold:
				cleaned_array[top:top + block_size, left:left + block_size] = 1.0

	return cleaned_array


def detect_text_regions(
	reader: easyocr.Reader,
	image_array: np.ndarray,
	scan_size: int = 200,
	region_size: int = 150,
	minimum_confidence: float = 0.30,
) -> list[tuple[int, int, int, int]]:
	"""Scan 200x200 tiles and return 150x150 regions containing detected text."""
	if image_array.ndim != 2:
		raise ValueError("image_array must be a 2D grayscale array")
	if scan_size <= 0 or region_size <= 0 or region_size > scan_size:
		raise ValueError("region_size must be between 1 and scan_size")
	if not 0.0 <= minimum_confidence <= 1.0:
		raise ValueError("minimum_confidence must be between 0 and 1")

	height, width = image_array.shape
	regions = []
	for top in range(0, height, scan_size):
		for left in range(0, width, scan_size):
			tile = image_array[top:min(top + scan_size, height), left:min(left + scan_size, width)]
			ocr_image = np.round(tile * 255.0).astype(np.uint8)
			text_found = any(
				confidence >= minimum_confidence
				for _points, _text, confidence in reader.readtext(ocr_image)
			)
			if not text_found:
				continue

			region_left = left + (tile.shape[1] - region_size) // 2
			region_top = top + (tile.shape[0] - region_size) // 2
			regions.append((
				max(0, region_left),
				max(0, region_top),
				min(width, region_left + region_size),
				min(height, region_top + region_size),
			))

	return regions


def merge_nearby_regions(
	regions: list[tuple[int, int, int, int]],
	merge_distance: int = 200,
) -> list[tuple[int, int, int, int]]:
	"""Merge regions with horizontal and vertical gaps of at most 200 pixels."""
	merged = regions.copy()
	changed = True
	while changed:
		changed = False
		for first_index in range(len(merged)):
			for second_index in range(first_index + 1, len(merged)):
				first = merged[first_index]
				second = merged[second_index]
				horizontal_gap = max(first[0] - second[2], second[0] - first[2], 0)
				vertical_gap = max(first[1] - second[3], second[1] - first[3], 0)
				if horizontal_gap > merge_distance or vertical_gap > merge_distance:
					continue

				merged[first_index] = (
					min(first[0], second[0]),
					min(first[1], second[1]),
					max(first[2], second[2]),
					max(first[3], second[3]),
				)
				del merged[second_index]
				changed = True
				break
			if changed:
				break
	return merged


def add_text_borders(
	image_array: np.ndarray,
	regions: list[tuple[int, int, int, int]],
	border_width: int = 5,
) -> np.ndarray:
	"""Draw red borders around the merged text regions."""
	annotated = np.repeat(image_array[:, :, np.newaxis], 3, axis=2)
	red = np.array([1.0, 0.0, 0.0], dtype=np.float32)
	height, width = image_array.shape
	for left, top, right, bottom in regions:
		left = max(0, left - border_width)
		top = max(0, top - border_width)
		right = min(width, right + border_width)
		bottom = min(height, bottom + border_width)
		annotated[top:top + border_width, left:right] = red
		annotated[bottom - border_width:bottom, left:right] = red
		annotated[top:bottom, left:left + border_width] = red
		annotated[top:bottom, right - border_width:right] = red
	return annotated


def display_image(image_array: np.ndarray, image_name: str) -> None:
	"""Display a normalized image where 0 is black and 1 is white."""
	plt.figure(figsize=(5, 5))
	plt.imshow(image_array, cmap="gray", vmin=0.0, vmax=1.0)
	plt.axis("off")
	plt.title(f"{image_name} | {image_array.shape[1]} x {image_array.shape[0]}")
	plt.show()
	plt.close()


def process_images(
	input_folder: Path,
	output_folder: Path,
	display_images: bool,
) -> None:
	"""Process every PDF in input_folder and optionally display each result."""
	pdf_files = sorted(input_folder.glob("*.pdf"))
	if not pdf_files:
		raise FileNotFoundError(f"No PDF files found in {input_folder}")

	reader = easyocr.Reader(["en"], gpu=False)
	output_folder.mkdir(parents=True, exist_ok=True)
	for pdf_path in pdf_files:
		original_image = render_pdf(pdf_path)
		resized_image = downsample(original_image)
		normalized_array = normalize_pixels(resized_image)
		cleaned_array = remove_dark_blocks(normalized_array)
		text_regions = detect_text_regions(reader, cleaned_array)
		merged_regions = merge_nearby_regions(text_regions)
		annotated_array = add_text_borders(cleaned_array, merged_regions)
		output_path = output_folder / f"{pdf_path.stem}_annotated.npy"
		image_path = output_folder / f"{pdf_path.stem}_annotated.png"
		np.save(output_path, annotated_array)
		plt.imsave(image_path, annotated_array)

		print(
			f"{pdf_path.name}: detected {len(text_regions)} regions, "
			f"merged to {len(merged_regions)} borders"
		)
		print(f"Saved annotated image: {image_path}")

		if display_images:
			display_image(annotated_array, pdf_path.stem)


def main() -> None:
	parser = argparse.ArgumentParser(
		description="Resize PDF images to 300x300 and normalize pixels to 0-1."
	)
	parser.add_argument("--input", type=Path, default=DEFAULT_INPUT_FOLDER)
	parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT_FOLDER)
	parser.add_argument(
		"--no-display",
		action="store_true",
		help="Process and save images without opening display windows.",
	)
	args = parser.parse_args()
	process_images(args.input, args.output, not args.no_display)


if __name__ == "__main__":
	main()
