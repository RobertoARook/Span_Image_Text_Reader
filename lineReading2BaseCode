import argparse
from pathlib import Path

import cv2
import easyocr
import matplotlib.pyplot as plt
import numpy as np
import pymupdf


DEFAULT_INPUT_FOLDER = Path(__file__).with_name("text_images_span")
DEFAULT_MIN_CONTOUR_AREA = 1_000_000


def load_image(path: Path) -> np.ndarray:
	"""Load an image file or render the first page of a PDF as BGR pixels."""
	if path.suffix.lower() == ".pdf":
		with pymupdf.open(path) as document:
			if not document.page_count:
				raise ValueError(f"{path.name} has no pages")
			pixmap = document[0].get_pixmap(alpha=False)
			rgb_image = np.frombuffer(pixmap.samples, dtype=np.uint8).reshape(
				pixmap.height,
				pixmap.width,
				3,
			)
			return cv2.cvtColor(rgb_image, cv2.COLOR_RGB2BGR)

	image = cv2.imread(str(path), cv2.IMREAD_COLOR)
	if image is None:
		raise ValueError(f"Could not read {path}")
	return image


def preprocess_image(
	image: np.ndarray,
	block_size: int = 31,
	constant: int = 11,
	area_size: int = 100,
	minimum_mean: float = 0.700,
) -> tuple[np.ndarray, np.ndarray]:
	"""Filter dark image tiles, threshold the image, and close gaps."""
	if block_size < 3 or block_size % 2 == 0:
		raise ValueError("block_size must be an odd integer greater than or equal to 3")
	if area_size <= 0:
		raise ValueError("area_size must be greater than 0")
	if not 0.0 <= minimum_mean <= 1.0:
		raise ValueError("minimum_mean must be between 0.0 and 1.0")

	grayscale = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
	blurred = cv2.GaussianBlur(grayscale, (5, 5), 0)
	filtered = blurred.copy()
	minimum_pixel_mean = minimum_mean * 255.0
	for top in range(0, filtered.shape[0], area_size):
		for left in range(0, filtered.shape[1], area_size):
			bottom = min(top + area_size, filtered.shape[0])
			right = min(left + area_size, filtered.shape[1])
			area = filtered[top:bottom, left:right]
			if float(area.mean()) < minimum_pixel_mean:
				filtered[top:bottom, left:right] = 255

	binary = cv2.adaptiveThreshold(
		filtered,
		255,
		cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
		cv2.THRESH_BINARY_INV,
		block_size,
		constant,
	)
	kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (500, 500))
	closed = cv2.morphologyEx(binary, cv2.MORPH_CLOSE, kernel)
	return grayscale, closed


def find_contours(
	closed: np.ndarray,
	minimum_area: int = DEFAULT_MIN_CONTOUR_AREA,
) -> list[np.ndarray]:
	"""Find and sort large external contours by area."""
	contours, _ = cv2.findContours(
		closed,
		cv2.RETR_EXTERNAL,
		cv2.CHAIN_APPROX_SIMPLE,
	)
	image_area = closed.shape[0] * closed.shape[1]
	large_contours = [
		contour
		for contour in contours
		if minimum_area <= cv2.contourArea(contour) <= image_area * 0.95
	]
	return sorted(large_contours, key=cv2.contourArea, reverse=True)


def crop_largest_region(
	image: np.ndarray,
	contours: list[np.ndarray],
) -> np.ndarray | None:
	"""Crop the image to the largest detected region."""
	if not contours:
		return None

	x, y, width, height = cv2.boundingRect(contours[0])
	return image[y:y + height, x:x + width].copy()


def preprocess_cropped_region(image: np.ndarray) -> np.ndarray:
	"""Reapply grayscale, blur, adaptive threshold, and morphological closing."""
	grayscale = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
	blurred = cv2.GaussianBlur(grayscale, (5, 5), 0)
	binary = cv2.adaptiveThreshold(
		blurred,
		255,
		cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
		cv2.THRESH_BINARY_INV,
		31,
		11,
	)
	kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (1, 1))
	return cv2.morphologyEx(binary, cv2.MORPH_CLOSE, kernel)


def draw_contours(image: np.ndarray, contours: list[np.ndarray]) -> np.ndarray:
	"""Black out pixels outside contours and draw their blue outlines."""
	mask = np.zeros(image.shape[:2], dtype=np.uint8)
	if contours:
		cv2.drawContours(mask, contours, -1, 255, cv2.FILLED)
	annotated = cv2.bitwise_and(image, image, mask=mask)
	cv2.drawContours(annotated, contours, -1, (255, 0, 0), 5)
	return annotated


def highlight_horizontal_strokes(
	image: np.ndarray,
	interior_border: int = 230,
	minimum_width: int = 25,
	maximum_height: int = 45,
	connection_width: int = 100,
) -> np.ndarray:
	"""Find mostly horizontal strokes, bridge nearby gaps, and color them green."""
	if interior_border < 0:
		raise ValueError("interior_border must not be negative")
	if connection_width < 0:
		raise ValueError("connection_width must not be negative")

	search_area = image.copy()
	if interior_border:
		search_area[:interior_border, :] = 0
		search_area[-interior_border:, :] = 0
		search_area[:, :interior_border] = 0
		search_area[:, -interior_border:] = 0

	horizontal_kernel = cv2.getStructuringElement(
		cv2.MORPH_RECT,
		(minimum_width, 1),
	)
	horizontal_mask = cv2.morphologyEx(
		search_area,
		cv2.MORPH_OPEN,
		horizontal_kernel,
	)
	connection_kernel = cv2.getStructuringElement(
		cv2.MORPH_ELLIPSE,
		(connection_width * 2 + 1, 9),
	)
	horizontal_mask = cv2.morphologyEx(
		horizontal_mask,
		cv2.MORPH_CLOSE,
		connection_kernel,
	)
	stroke_contours, _ = cv2.findContours(
		horizontal_mask,
		cv2.RETR_EXTERNAL,
		cv2.CHAIN_APPROX_SIMPLE,
	)
	annotated = cv2.cvtColor(image, cv2.COLOR_GRAY2BGR)
	for stroke in stroke_contours:
		x, y, width, height = cv2.boundingRect(stroke)
		if width >= 45 and height <= maximum_height:
			cv2.drawContours(annotated, [stroke], -1, (0, 255, 0), 5)
	return annotated


def detect_text_above_green_lines(
	reader: easyocr.Reader,
	image: np.ndarray,
	text_height: int = 40,
	expansion_step: int = 8,
	maximum_extension: int = 40,
) -> tuple[np.ndarray, list[str]]:
	"""Detect complete phrases above green lines and highlight them orange."""
	if image.ndim != 3 or image.shape[2] != 3:
		raise ValueError("image must be a BGR color image")
	if text_height <= 0 or expansion_step <= 0 or maximum_extension < 0:
		raise ValueError("text_height and expansion_step must be positive")

	green_mask = cv2.inRange(
		image,
		np.array([0, 180, 0], dtype=np.uint8),
		np.array([120, 255, 120], dtype=np.uint8),
	)
	line_contours, _ = cv2.findContours(
		green_mask,
		cv2.RETR_EXTERNAL,
		cv2.CHAIN_APPROX_SIMPLE,
	)
	annotated = image.copy()
	texts = []
	image_height, image_width = image.shape[:2]

	for line in line_contours:
		x, y, width, height = cv2.boundingRect(line)
		if width < 30:
			continue

		left = x
		right = min(image_width, x + width)
		line_left = left
		line_right = right
		crop_top = max(0, y - text_height)
		crop_bottom = min(image_height, y + height)
		detections = []
		expanded_left = 0
		expanded_right = 0
		left_blocked = False
		right_blocked = False

		def contains_black_run(region: np.ndarray) -> bool:
			black_pixels = np.all(region <= 50, axis=2).astype(np.uint8) * 255
			run_kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (10, 1))
			return cv2.countNonZero(
				cv2.erode(black_pixels, run_kernel)
			) > 0

		while True:
			text_crop = image[crop_top:crop_bottom, left:right]
			if text_crop.size == 0:
				break
			detections = reader.readtext(text_crop)
			touches_left = any(
				min(point[0] for point in points) <= 5
				for points, _text, _confidence in detections
			)
			touches_right = any(
				max(point[0] for point in points) >= text_crop.shape[1] - 5
				for points, _text, _confidence in detections
			)
			can_expand_left = (
				touches_left
				and not left_blocked
				and expanded_left < maximum_extension
			)
			can_expand_right = (
				touches_right
				and not right_blocked
				and expanded_right < maximum_extension
			)
			if not can_expand_left and not can_expand_right:
				break
			if can_expand_left:
				new_left = max(0, left - expansion_step)
				new_strip = image[crop_top:crop_bottom, new_left:line_left]
				expanded_left += left - new_left
				left = new_left
				if contains_black_run(new_strip):
					left_blocked = True
			if can_expand_right:
				new_right = min(image_width, right + expansion_step)
				new_strip = image[crop_top:crop_bottom, line_right:new_right]
				expanded_right += new_right - right
				right = new_right
				if contains_black_run(new_strip):
					right_blocked = True

		text_detections = []
		for points, text, _confidence in detections:
			polygon = np.asarray(points, dtype=np.int32)
			polygon[:, 0] += left
			polygon[:, 1] += crop_top
			box_left, box_top, box_width, box_height = cv2.boundingRect(polygon)
			text_detections.append({
				"left": box_left,
				"top": box_top,
				"right": box_left + box_width,
				"bottom": box_top + box_height,
				"texts": [text],
			})

		merged = True
		while merged:
			merged = False
			for first_index, first in enumerate(text_detections):
				for second_index in range(first_index + 1, len(text_detections)):
					second = text_detections[second_index]
					horizontal_gap = max(
						0,
						first["left"] - second["right"],
						second["left"] - first["right"],
					)
					vertical_overlap = min(first["bottom"], second["bottom"]) - max(
						first["top"], second["top"]
					)
					if horizontal_gap > 80 or vertical_overlap <= 0:
						continue

					first["left"] = min(first["left"], second["left"])
					first["top"] = min(first["top"], second["top"])
					first["right"] = max(first["right"], second["right"])
					first["bottom"] = max(first["bottom"], second["bottom"])
					first["texts"].extend(second["texts"])
					del text_detections[second_index]
					merged = True
					break
				if merged:
					break

		for detection in sorted(text_detections, key=lambda item: (item["top"], item["left"])):
			texts.append(" ".join(detection["texts"]))
			cv2.rectangle(
				annotated,
				(detection["left"], detection["top"]),
				(detection["right"], detection["bottom"]),
				(0, 165, 255),
				4,
			)

	return annotated, texts


def display_image_with_text(
	image: np.ndarray,
	texts: list[str],
	title: str,
) -> None:
	"""Display an image with detected text in red on its right."""
	figure, axes = plt.subplots(
		1,
		2,
		figsize=(16, 8),
		gridspec_kw={"width_ratios": [3, 1]},
	)
	axes[0].imshow(cv2.cvtColor(image, cv2.COLOR_BGR2RGB))
	axes[0].axis("off")
	axes[1].set_facecolor("white")
	axes[1].axis("off")
	axes[1].text(
		0.03,
		0.97,
		"\n".join(texts) if texts else "No text detected",
		color="red",
		fontsize=12,
		verticalalignment="top",
		wrap=True,
		transform=axes[1].transAxes,
	)
	figure.suptitle(title)
	figure.tight_layout()
	plt.show()
	plt.close(figure)


def process_file(
	path: Path,
	reader: easyocr.Reader,
	minimum_area: int,
	show: bool,
) -> None:
	"""Run the complete OpenCV and EasyOCR pipeline for one file."""
	image = load_image(path)
	_grayscale, closed = preprocess_image(image)
	contours = find_contours(closed, minimum_area)
	contour_annotated = draw_contours(image, contours)
	largest_region = crop_largest_region(contour_annotated, contours)
	if largest_region is None:
		annotated = image
		texts = []
	else:
		preprocessed_region = preprocess_cropped_region(largest_region)
		stroke_annotated = highlight_horizontal_strokes(preprocessed_region)
		annotated, texts = detect_text_above_green_lines(reader, stroke_annotated)
		if show:
			display_image_with_text(
				annotated,
				texts,
				f"{path.name} - text above highlighted strokes",
			)
	print(f"{path.name}: {len(contours)} region(s), {len(texts)} text result(s)")
	if texts:
		print("Detected text:", " ".join(texts))


def main() -> None:
	parser = argparse.ArgumentParser(description="Detect and OCR text regions in images or PDFs.")
	parser.add_argument("--input", type=Path, default=DEFAULT_INPUT_FOLDER)
	parser.add_argument("--minimum-area", type=int, default=DEFAULT_MIN_CONTOUR_AREA)
	parser.add_argument("--no-display", action="store_true")
	args = parser.parse_args()

	paths = sorted(
		path for path in args.input.iterdir()
		if path.suffix.lower() in {".pdf", ".png", ".jpg", ".jpeg", ".bmp", ".tif", ".tiff"}
	)
	if not paths:
		raise FileNotFoundError(f"No supported image files found in {args.input}")

	reader = easyocr.Reader(["es"], gpu=False)
	for path in paths:
		process_file(path, reader, args.minimum_area, not args.no_display)


if __name__ == "__main__":
	main()
